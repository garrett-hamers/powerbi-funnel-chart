{
  "privileges": [],
  "supportsHighlight": true,
  "supportsKeyboardFocus": true,
  "supportsMultiVisualSelection": true,
  "supportsEmptyDataView": true,
  "tooltips": {
    "supportedTypes": {
      "default": true,
      "canvas": true
    },
    "roles": [
      "Tooltips"
    ],
    "supportEnhancedTooltips": true
  },
  "dataRoles": [
    {
      "displayName": "Stage",
      "displayNameKey": "Role_Stage_DisplayNameKey",
      "name": "Stage",
      "kind": "Grouping",
      "description": "Ordered process stage",
      "descriptionKey": "Role_Stage_DescriptionKey"
    },
    {
      "displayName": "Value",
      "displayNameKey": "Role_Value_DisplayNameKey",
      "name": "Value",
      "kind": "Measure",
      "description": "Stage volume or amount",
      "descriptionKey": "Role_Value_DescriptionKey",
      "requiredTypes": [
        {
          "numeric": true
        }
      ]
    },
    {
      "displayName": "Stage order",
      "displayNameKey": "Role_StageOrder_DisplayNameKey",
      "name": "StageOrder",
      "kind": "Measure",
      "description": "Optional numeric order; ties are diagnosed",
      "descriptionKey": "Role_StageOrder_DescriptionKey",
      "requiredTypes": [
        {
          "numeric": true
        }
      ]
    },
    {
      "displayName": "Target",
      "displayNameKey": "Role_Target_DisplayNameKey",
      "name": "Target",
      "kind": "Measure",
      "description": "Optional benchmark for each stage",
      "descriptionKey": "Role_Target_DescriptionKey",
      "requiredTypes": [
        {
          "numeric": true
        }
      ]
    },
    {
      "displayName": "Group",
      "displayNameKey": "Role_Group_DisplayNameKey",
      "name": "Group",
      "kind": "Grouping",
      "description": "Optional segment",
      "descriptionKey": "Role_Group_DescriptionKey"
    },
    {
      "displayName": "Tooltips",
      "displayNameKey": "Role_Tooltips_DisplayNameKey",
      "name": "Tooltips",
      "kind": "GroupingOrMeasure",
      "description": "Optional detail fields (up to five)",
      "descriptionKey": "Role_Tooltips_DescriptionKey"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "Stage": {
            "min": 1,
            "max": 1
          },
          "Value": {
            "min": 1,
            "max": 1
          },
          "StageOrder": {
            "max": 1
          },
          "Target": {
            "max": 1
          },
          "Group": {
            "max": 1
          },
          "Tooltips": {
            "max": 5
          }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            {
              "for": {
                "in": "Stage"
              }
            },
            {
              "for": {
                "in": "Group"
              }
            },
            {
              "for": {
                "in": "Tooltips"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "window": {
              "count": 50
            }
          }
        },
        "values": {
          "select": [
            {
              "for": {
                "in": "Value"
              }
            },
            {
              "for": {
                "in": "StageOrder"
              }
            },
            {
              "for": {
                "in": "Target"
              }
            },
            {
              "for": {
                "in": "Tooltips"
              }
            }
          ]
        }
      }
    }
  ],
  "objects": {
    "dataPoint": {
      "displayName": "Data points",
      "displayNameKey": "Object_DataPoint_DisplayNameKey",
      "properties": {
        "fill": {
          "displayName": "Fill",
          "displayNameKey": "Property_DataPointFill_DisplayNameKey",
          "description": "Color used for positive data points.",
          "descriptionKey": "Property_DataPointFill_DescriptionKey",
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        }
      }
    },
    "labels": {
      "displayName": "Labels",
      "displayNameKey": "Object_Labels_DisplayNameKey",
      "properties": {
        "show": {
          "displayName": "Show chart labels",
          "displayNameKey": "Property_LabelsShow_DisplayNameKey",
          "description": "Show stage labels and values on the chart.",
          "descriptionKey": "Property_LabelsShow_DescriptionKey",
          "type": {
            "bool": true
          }
        }
      }
    }
  }
}
