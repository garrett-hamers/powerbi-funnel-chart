{
  "name": "atlyn-funnel",
  "version": "1.0.1",
  "private": true,
  "description": "Atlyn Funnel Power BI custom visual",
  "scripts": {
    "build": "webpack --mode production",
    "typecheck": "tsc --noEmit",
    "eslint": "npx eslint . --ext .js,.jsx,.ts,.tsx",
    "lint": "npm run eslint",
    "test": "jest --runInBand",
    "package": "node scripts/package.cjs",
    "layout-probe": "node scripts/layout-probe.cjs",
    "screenshots": "node scripts/capture-screenshots.cjs",
    "icons": "node scripts/build-icons.cjs",
    "sample-report": "node scripts/build-sample-report.cjs",
    "release-manifest": "node scripts/release-manifest.cjs",
    "certification-audit": "node scripts/certification-audit.cjs",
    "audit": "npm audit"
  },
  "dependencies": {
    "powerbi-visuals-api": "^5.11.0",
    "powerbi-visuals-utils-formattingutils": "^6.1.2"
  },
  "overrides": {
    "sockjs": {
      "uuid": "^11.1.1"
    },
    "hono": "^4.12.34"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.4",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "css-loader": "^7.1.4",
    "eslint": "^9.20.1",
    "eslint-plugin-powerbi-visuals": "^1.1.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jszip": "3.10.1",
    "mini-css-extract-plugin": "^2.10.2",
    "powerbi-visuals-tools": "^7.2.1",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "typescript": "^5.7.3",
    "webpack": "^5.102.0",
    "webpack-cli": "^6.0.1"
  }
}
