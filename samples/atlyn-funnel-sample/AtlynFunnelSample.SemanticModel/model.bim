            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Source = #table(",
                "        type table [#\"Stage\" = text, #\"StageOrder\" = Int64.Type, #\"Segment\" = text, #\"Value\" = Int64.Type, #\"Target\" = Int64.Type],",
                "        {",
